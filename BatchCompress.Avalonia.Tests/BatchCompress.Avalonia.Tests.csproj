<Project Sdk="Microsoft.NET.Sdk">
  <!-- GPT-5, 2026-08-05：将测试保持为轻依赖可执行程序，使其无需 Avalonia 桌面会话即可运行。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- GPT-5, 2026-08-05：直接链接生产源码，以测试应用实际交付的同一套命令和进程代码。 -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\CommandLineHandler.cs" Link="CommandLineHandler.cs" />
    <Compile Include="..\Core\Interfaces\IArchiveEngine.cs" Link="Core\Interfaces\IArchiveEngine.cs" />
    <Compile Include="..\Core\Services\WinRarCommandBuilder.cs" Link="Core\Services\WinRarCommandBuilder.cs" />
    <Compile Include="..\Core\Services\WinRarProcessRunner.cs" Link="Core\Services\WinRarProcessRunner.cs" />
    <Compile Include="..\Core\Services\ArchiveProcessRunner.cs" Link="Core\Services\ArchiveProcessRunner.cs" />
    <Compile Include="..\Core\Services\SevenZipCommandBuilder.cs" Link="Core\Services\SevenZipCommandBuilder.cs" />
    <Compile Include="..\Core\Services\SevenZipArchiveEngine.cs" Link="Core\Services\SevenZipArchiveEngine.cs" />
    <Compile Include="..\Core\Services\ArchiveEngineRouter.cs" Link="Core\Services\ArchiveEngineRouter.cs" />
    <Compile Include="..\Core\Services\ArchiveVolumeResolver.cs" Link="Core\Services\ArchiveVolumeResolver.cs" />
    <Compile Include="..\Core\Services\RarArchiveEngine.cs" Link="Core\Services\RarArchiveEngine.cs" />
    <Compile Include="..\Core\Services\OutputPathResolver.cs" Link="Core\Services\OutputPathResolver.cs" />
    <Compile Include="..\Core\Services\PasswordUtility.cs" Link="Core\Services\PasswordUtility.cs" />
    <Compile Include="..\Core\Services\SystemMetadataFileFilter.cs" Link="Core\Services\SystemMetadataFileFilter.cs" />
    <Compile Include="..\Core\Services\BatchOperationService.cs" Link="Core\Services\BatchOperationService.cs" />
    <Compile Include="..\Core\Models\OperationModels.cs" Link="Core\Models\OperationModels.cs" />
    <Compile Include="..\Core\Models\ArchiveDefaults.cs" Link="Core\Models\ArchiveDefaults.cs" />
    <Compile Include="..\Core\Models\ArchiveFormatCatalog.cs" Link="Core\Models\ArchiveFormatCatalog.cs" />
    <Compile Include="..\Core\Interfaces\ISystemIntegration.cs" Link="Core\Interfaces\ISystemIntegration.cs" />
    <Compile Include="..\Localization\LanguageStrings.cs" Link="Localization\LanguageStrings.cs" />
    <Compile Include="..\Localization\LocalizationService.cs" Link="Localization\LocalizationService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- GPT-5, 2026-08-06：macOS 回归测试使用项目内官方 7zz，不依赖机器全局安装。 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="..\tools\7zip\macos\7zz" Link="tools\7zip\macos\7zz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
