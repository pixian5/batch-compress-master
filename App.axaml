<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BatchCompress.Avalonia.App"
             xmlns:local="using:BatchCompress.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <!-- GPT-5, 2026-08-05：应用级视觉默认值使标准控件和黄色提示气泡保持一致。 -->
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#FFF4B8" />
            <Setter Property="Foreground" Value="#3D3100" />
            <Setter Property="BorderBrush" Value="#D6A600" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Application.Styles>

</Application>
