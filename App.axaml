<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BatchCompress.Avalonia.App"
             xmlns:local="using:BatchCompress.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <!-- GPT-5, 2026-08-05：应用级视觉默认值使标准控件和黄色提示气泡保持一致。 -->
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#FFF4B8" />
            <Setter Property="Foreground" Value="#3D3100" />
            <Setter Property="BorderBrush" Value="#D6A600" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Application.Styles>

    <!-- GPT-5, 2026-08-05：Avalonia 负责原生托盘适配；菜单动作调用 App 生命周期方法。 -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/压缩.png" ToolTipText="批量压缩解压工具" Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="显示/隐藏" Click="TrayShowHide_Clicked" />
                        <NativeMenuItem Header="退出" Click="TrayExit_Clicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
